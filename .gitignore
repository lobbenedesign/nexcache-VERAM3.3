# Build artifacts
*.o
*.d
*.a
*.so
*.dylib
*.xo
*.pyc
__pycache__/
build_macos.log
build/

# Generated by make (per-file dep caches, settings snapshots)
src/.make-*
src/Makefile.dep
src/release.h
src/check_offsets

# Binaries produced by the build
src/nexcache-server
src/nexcache-cli
src/nexcache-benchmark
src/nexcache-sentinel
src/nexcache-check-aof
src/nexcache-check-rdb

# Lua module build output
src/modules/lua/*.so

# Test/module .so and .xo output
tests/modules/*.so
tests/modules/*.xo
tests/unit/__pycache__/

# Deps build output (keep sources, ignore compiled objects/libs already covered by *.o/*.a above)
deps/lua/src/lua
deps/lua/src/luac
deps/lua/src/liblua.a

# macOS
.DS_Store

# Claude Code local session state
.claude/

# Logs from local test/benchmark runs
*.log
